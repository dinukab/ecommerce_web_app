# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://allinoneshop.store

# ── Database ─────────────────────────────────────────────────────────────────
# A single MongoDB server hosts every tenant. Point this at the cluster only —
# each tenant lives in its own database on that cluster, selected per request.
# The database named here is used solely as the connection's default.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Registry database written by oneshop-tenant-factory. Used to map a request's
# subdomain to that tenant's database name.
TENANT_FACTORY_DB=oneshop-tenant-factory

# How long a resolved subdomain -> database mapping is cached, in ms.
TENANT_CACHE_TTL_MS=60000

# ── Tenant resolution ────────────────────────────────────────────────────────
# Used when the request host carries no tenant subdomain (localhost, apex
# domain, health checks). Set this to run the storefront for a single tenant.
DEFAULT_TENANT_DB=oneshop_open_door

# Trust X-Forwarded-Host for tenant resolution. Turn this ON whenever the API
# sits behind CloudFront, an ALB, or a Lambda Function URL — those rewrite Host
# to the origin's own name, so without this every tenant collapses onto
# DEFAULT_TENANT_DB. Leave it OFF when the API is reachable directly, since the
# header is spoofable by any caller.
TRUST_PROXY_HOST=true

# Allows an explicit OneShop-Tenant-ID header to select the tenant. The
# storefront is public, so leaving this off is what stops a visitor from
# reading another tenant's catalogue by setting one header. Enable only for
# local testing or trusted internal tooling.
ALLOW_TENANT_HEADER=false

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_me_with_a_long_random_string

# ── Payments ─────────────────────────────────────────────────────────────────
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_IS_SANDBOX=true
BACKEND_URL=http://localhost:5000
